# Base de données Postgres
DATABASE_URL=postgres://pcrf:pcrf@127.0.0.1:5432/pcrf
# Clé secrète Payload (longue chaîne aléatoire)
PAYLOAD_SECRET=
# Adresse publique du site
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
# Stockage S3 compatible (laisser vide en local : fichiers sur disque)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dossier des médias de l'ancien site (servis sous /legacy-media/ en local)
LEGACY_MEDIA_DIR=../migration/media
# Envoi de mails (mot de passe oublié). Ex. Brevo : smtp-relay.brevo.com, port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=site@pcrf-ic.fr
# En production : adresse publique du dossier migration/media copié dans le bucket (sert /legacy-media/)
LEGACY_MEDIA_BASE_URL=
